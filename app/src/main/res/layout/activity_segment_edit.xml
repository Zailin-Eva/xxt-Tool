<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tt_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout style="@style/TtTopBar">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:tint="@color/tt_ink" />

        <TextView
            style="@style/TtTitle"
            android:layout_marginStart="6dp"
            android:text="时间段" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="4dp"
            android:text="保存"
            android:textColor="@color/tt_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="4dp"
            android:paddingRight="18dp"
            android:paddingBottom="40dp">

            <TextView style="@style/TtLabel" android:text="星期" />

            <Spinner
                android:id="@+id/spDay"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_field"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:spinnerMode="dialog" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/TtLabel" android:text="开始节次" />

                    <Spinner
                        android:id="@+id/spStart"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_field"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:spinnerMode="dialog" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/TtLabel" android:text="结束节次" />

                    <Spinner
                        android:id="@+id/spEnd"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_field"
                        android:paddingLeft="8dp"
                        android:paddingRight="8dp"
                        android:spinnerMode="dialog" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/TtLabel" android:text="上课周次" />

            <com.xxkg.board.WeekChipsView
                android:id="@+id/weekChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnAllWeeks"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:gravity="center"
                    android:text="全选"
                    android:textColor="@color/tt_ink"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnOddWeeks"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:gravity="center"
                    android:text="单周"
                    android:textColor="@color/tt_ink"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnEvenWeeks"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:gravity="center"
                    android:text="双周"
                    android:textColor="@color/tt_ink"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/btnClearWeeks"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:gravity="center"
                    android:text="清空"
                    android:textColor="@color/tt_ink"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView style="@style/TtLabel" android:text="校区（可选）" />

            <EditText
                android:id="@+id/etCampus"
                style="@style/TtField"
                android:hint="例如：沙河校区"
                android:textColorHint="@color/tt_muted2" />

            <TextView style="@style/TtLabel" android:text="地点" />

            <EditText
                android:id="@+id/etLocation"
                style="@style/TtField"
                android:hint="例如：沙河二教306 / 体育场"
                android:textColorHint="@color/tt_muted2" />

            <TextView style="@style/TtLabel" android:text="教师（可选）" />

            <EditText
                android:id="@+id/etTeacher"
                style="@style/TtField"
                android:hint="不填则使用课程教师"
                android:textColorHint="@color/tt_muted2" />

            <TextView
                android:id="@+id/btnDeleteSegment"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="删除这个时间段"
                android:textColor="@color/tt_danger"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
