<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tt_accent_soft" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/tt_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tt_surface" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="@color/tt_line" />
        </shape>
    </item>
</selector>
